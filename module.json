{
  "id": "bag-of-worlds",
  "title": "Bag of Worlds",
  "description": "Companion module for the Bag of Worlds mobile app: lets players use their character sheet and the battle map from a phone. Unofficial; not affiliated with or endorsed by Foundry Gaming LLC.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "12",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Bag of Worlds Team"
    }
  ],
  "esmodules": [
    "scripts/mobile-bridge.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "languages/ru.json"
    }
  ],
  "relationships": {
    "recommends": [
      {
        "id": "elevationruler",
        "type": "module",
        "reason": "The built-in movement grid reuses Elevation Ruler's pathfinding configuration (token blocking rules, ignored statuses) when present."
      }
    ]
  },
  "socket": true,
  "manifest": "https://github.com/Alexander-Radionov/bag_of_worlds/releases/latest/download/module.json",
  "download": "https://github.com/Alexander-Radionov/bag_of_worlds/releases/download/v1.0.0/bag-of-worlds.zip",
  "url": "https://github.com/Alexander-Radionov/bag_of_worlds",
  "readme": "https://github.com/Alexander-Radionov/bag_of_worlds/blob/main/README.md",
  "changelog": "https://github.com/Alexander-Radionov/bag_of_worlds/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/Alexander-Radionov/bag_of_worlds/issues",
  "license": "LICENSE"
}
